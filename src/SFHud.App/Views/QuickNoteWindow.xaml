<Window x:Class="SFHud.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SFHud.Controls"
        Title="SFHud Quick Note" Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource F.Body}" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <c:HudFrame Chamfer="14" ShowTab="True" Glow="True" Padding="20,16,20,14" Margin="10"
                Stroke="{DynamicResource B.Accent}" Fill="{DynamicResource B.Bg}">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="ContextText" DockPanel.Dock="Right" Style="{StaticResource T.Label}" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Text="QUICK NOTE" Style="{StaticResource T.H2}"/>
            </DockPanel>
            <WrapPanel x:Name="PadChips" Margin="0,0,0,6"/>
            <ContentControl x:Name="ToolbarHost"/>
            <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" MaxHeight="260"
                     VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource F.Body}" FontSize="14"
                     PreviewKeyDown="NoteBox_PreviewKeyDown" TextChanged="NoteBox_TextChanged"/>
            <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Right" x:Name="DraftText" Style="{StaticResource T.Label}" FontSize="10"/>
                <TextBlock Text="ENTER SAVE  ·  SHIFT+ENTER NEW LINE  ·  TAB NEXT PAD  ·  CTRL+B/I/U  ·  ESC CLOSE" Style="{StaticResource T.Label}" FontSize="10"/>
            </DockPanel>
        </StackPanel>
    </c:HudFrame>
</Window>
