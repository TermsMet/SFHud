<Window x:Class="SFHud.Views.TimerPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SFHud.Controls"
        Title="SFHud Timer" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource F.Body}" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <c:HudFrame Chamfer="14" ShowTab="True" Glow="True" Padding="20,16,20,14" Margin="10"
                Stroke="{DynamicResource B.Amber}" TabBrush="{DynamicResource B.Amber}" BracketBrush="{DynamicResource B.Amber}"
                Fill="{DynamicResource B.Bg}">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Style="{StaticResource T.Label}" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="SET TIMER" Style="{StaticResource T.H2}" Foreground="{DynamicResource B.Amber}"/>
            </DockPanel>
            <TextBox x:Name="InputBox" FontFamily="{DynamicResource F.Mono}" FontSize="17"
                     PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"/>
            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="PreviewText" DockPanel.Dock="Right" FontFamily="{DynamicResource F.Mono}" FontSize="11"
                           Foreground="{DynamicResource B.Accent}"/>
                <TextBlock x:Name="HintText" Style="{StaticResource T.Label}" FontSize="10" TextWrapping="Wrap"
                           Text="5 · 90s · 7m30s patrol · 1:30 breach · @21:30 event · every 10m patrol"/>
            </DockPanel>
            <WrapPanel x:Name="Presets" Margin="0,12,0,0"/>
            <TextBlock Margin="0,8,0,0" Text="ENTER START  ·  ESC CLOSE  ·  CLICK A CHIP TO START IT" Style="{StaticResource T.Label}" FontSize="10"/>
        </StackPanel>
    </c:HudFrame>
</Window>
