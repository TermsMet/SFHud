<Window x:Class="SFHud.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SFHud.Controls"
        Title="SFHud" Width="1180" Height="760" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Body}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/SFHud;component/Assets/sfhud.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- Backdrop: optional image, wash, scanlines -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0.18"/>
        <Rectangle Fill="{DynamicResource B.Grid}" Opacity="0.045" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource B.Wash.Accent}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource B.Wash.Amber}" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource B.Scanlines}" Opacity="0.035" IsHitTestVisible="False" Visibility="{DynamicResource V.Scanlines}"/>
        <!-- Amber tab on the window's top edge, like the panels -->
        <Rectangle x:Name="TopTab" Width="64" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,0,0,0" Fill="{DynamicResource B.Amber}" IsHitTestVisible="False" Panel.ZIndex="10"/>
        <!-- Sci-fi window frame: cut corners and brackets around the whole window -->
        <!-- The window itself is clipped to this outline (WindowShape), so nothing shows past the cut corners. -->
        <c:HudFrame x:Name="WindowFrame" Fill="{x:Null}" Stroke="{DynamicResource B.Line.Strong}" Chamfer="22" ShowBrackets="True" BracketLength="34" BracketBrush="{DynamicResource B.Accent}" IsHitTestVisible="False" Panel.ZIndex="20" Corners="{DynamicResource Theme.Corners}"/>

        <Grid x:Name="Scaled">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ============ Title bar ============ -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/SFHud;component/Assets/sfhud-256.png" Width="28" Height="28" Margin="0,0,14,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="SFHUD" FontFamily="{DynamicResource F.Display}" FontWeight="SemiBold" FontSize="17" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TagLine" Text="//  GAME OVERLAY &amp; FIELD MANUAL" Style="{StaticResource T.Label}" Margin="16,1,0,0" VerticalAlignment="Center"/>
                        <Button x:Name="PresetBadge" Visibility="Collapsed" Style="{StaticResource Sf.IconButton}" Margin="12,0,0,0" Padding="8,0" WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Server preset and profile · click to switch" Click="PresetBadge_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PresetIcon" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{DynamicResource B.Accent}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PresetName" FontFamily="{DynamicResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProfileName" FontFamily="{DynamicResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.Dim}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Text="&#xE70D;" Style="{StaticResource T.Icon}" FontSize="9" Foreground="{DynamicResource B.Dim}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="SaveIndicator" Margin="0,0,8,0" Click="SaveNow_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Center"
                                ToolTip="Everything saves automatically. Click (or Ctrl+S) to save right now.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <c:HudFrame x:Name="F" Chamfer="5" ShowBrackets="False" Padding="9,3,10,4" Stroke="#8C7CFFB2" Fill="#147CFFB2">
                                        <ContentPresenter/>
                                    </c:HudFrame>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="F" Property="Fill" Value="#2E7CFFB2"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SaveGlyph" Text="●" FontSize="9" Foreground="{DynamicResource B.Ok}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LOCAL  ·  " FontFamily="{DynamicResource F.Mono}" FontSize="10.5" Foreground="{DynamicResource B.Ok}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SaveText" Text="SAVED" FontFamily="{DynamicResource F.Mono}" FontSize="10.5" Foreground="{DynamicResource B.Ok}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProButton" Click="Pro_Click" Margin="2,0,10,0" Padding="10,0" Height="26" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                ToolTip="SFHud Pro: one-time purchase. See what it adds.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <c:HudFrame x:Name="Bd" Chamfer="7" ShowBrackets="False" Stroke="{DynamicResource B.Amber}" Fill="{DynamicResource B.Amber.Fill}" Padding="{TemplateBinding Padding}" Opacity="0.85">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x2605;" FontSize="11" Foreground="{DynamicResource B.Amber}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </c:HudFrame>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="ProButtonText" Text="GET PRO" FontFamily="{DynamicResource F.Mono}" FontSize="10.5" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource Sf.Button.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource Sf.Button.Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                        <Button Style="{StaticResource Sf.Button.Caption.Close}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close SFHud (saves first)"/>
                    </StackPanel>

                    <!-- Global search -->
                    <!-- Fills the gap between the title and the right-hand buttons (max 300), so it never slides under the title. -->
                    <Grid x:Name="SearchHost" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="300" MinWidth="0" Margin="16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox x:Name="SearchBox" Padding="28,5,10,5" FontSize="12" TextChanged="Search_TextChanged" PreviewKeyDown="Search_KeyDown"
                                 ToolTip="Search notes, settings, keybinds, pages and presets (Ctrl+F)"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{DynamicResource B.Dim}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search everything   Ctrl+F" FontFamily="{DynamicResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.Muted}"
                                   Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="460">
                            <Border Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Line.Strong}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,4,0,0" MaxHeight="460">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SearchResults"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ============ Body ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="196"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource B.Divider.Vertical}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" x:Name="CollapseNav" Style="{StaticResource Sf.IconButton}" Content="&#xE76B;" HorizontalAlignment="Left" Margin="14,0,0,10"
                                Click="CollapseNav_Click" ToolTip="Compact sidebar"/>
                        <!-- Target box (bottom-left, as in 0.3) -->
                        <c:HudFrame DockPanel.Dock="Bottom" x:Name="TargetBox" Chamfer="8" ShowBrackets="False" Margin="14,0,14,10" Padding="12,9,12,10"
                                    Fill="{DynamicResource B.Panel}" Stroke="{DynamicResource B.Line}" Cursor="Hand" MouseLeftButtonUp="TargetBox_Click"
                                    ToolTip="Game, server preset and profile · click to switch">
                            <StackPanel>
                                <TextBlock Text="TARGET" Style="{StaticResource T.Label}" FontSize="10"/>
                                <TextBlock x:Name="TargetName" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" Margin="0,3,0,1" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TargetPreset" FontFamily="{DynamicResource F.Mono}" FontSize="10" Foreground="{DynamicResource B.Amber}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </c:HudFrame>
                        <TextBlock x:Name="NavCaption" DockPanel.Dock="Top" Text="NAVIGATION" Style="{StaticResource T.Label}" FontSize="10" Margin="24,18,0,12"/>
                        <StackPanel x:Name="NavPanel"/>
                    </DockPanel>
                </Border>

                <!-- The banner gets its own row above the page with a solid background, so it never covers page text. -->
                <DockPanel Grid.Column="1" LastChildFill="True">
                    <!-- Update bar: shows whenever the website has a newer version for this edition (Free or Pro). -->
                    <Border x:Name="UpdateBar" DockPanel.Dock="Top" Margin="22,14,22,0" CornerRadius="6" Visibility="Collapsed"
                            Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Accent}" BorderThickness="1">
                        <Border Background="{DynamicResource B.Accent.Fill}" Padding="14,9" CornerRadius="5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Sf.IconButton}" Content="&#xE8BB;" Click="UpdateBar_Close" VerticalAlignment="Center" ToolTip="Later (asks again next time SFHud starts)"/>
                                <Button x:Name="UpdateBarInstall" DockPanel.Dock="Right" Style="{StaticResource Sf.Button.Small.Primary}" Content="UPDATE NOW" Click="UpdateBar_Install" Margin="8,0,6,0" VerticalAlignment="Center"/>
                                <Button x:Name="UpdateBarNotes" DockPanel.Dock="Right" Style="{StaticResource Sf.Button.Small}" Content="WHAT'S NEW" Click="UpdateBar_Notes" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{DynamicResource B.Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateBarTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="UpdateBarText" FontSize="11.5" Foreground="{DynamicResource B.Dim}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>
                    <Border x:Name="Banner" DockPanel.Dock="Top" Margin="22,14,22,0" CornerRadius="6" Visibility="Collapsed"
                            Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Amber}" BorderThickness="1">
                        <Border Background="{DynamicResource B.Amber.Fill}" Padding="14,10" CornerRadius="5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Sf.IconButton}" Content="&#xE8BB;" Click="Banner_Close" VerticalAlignment="Top" ToolTip="Dismiss"/>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{DynamicResource B.Amber}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ScrollViewer x:Name="PageScroll" Style="{StaticResource Sf.Page}">
                        <ContentControl x:Name="PageHost" Margin="26,20,26,26" Focusable="False"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ============ Footer ============ -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,1,0,0">
                <DockPanel Margin="24,0">
                    <TextBlock DockPanel.Dock="Right" x:Name="FooterRight" FontFamily="{DynamicResource F.Mono}" FontSize="10.5" Foreground="{DynamicResource B.Dim}" VerticalAlignment="Center"/>
                    <Ellipse x:Name="FooterDot" Width="6" Height="6" Fill="{DynamicResource B.Ok}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterText" FontFamily="{DynamicResource F.Mono}" FontSize="10.5" Foreground="{DynamicResource B.Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
