<Window x:Class="SFHud.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SFHud Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{DynamicResource F.Body}" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" IsHitTestVisible="False">
    <Grid x:Name="Root">
        <!-- Customize-mode backdrop and grid -->
        <Rectangle x:Name="Backdrop" Fill="#8C000000" Visibility="Collapsed"/>
        <Rectangle x:Name="GridOverlay" Visibility="Collapsed" Opacity="0.08" IsHitTestVisible="False"/>

        <Canvas x:Name="Stage" ClipToBounds="True">
            <Canvas x:Name="World">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="WorldScale" ScaleX="1" ScaleY="1"/>
                </Canvas.RenderTransform>
            </Canvas>
            <Canvas x:Name="Guides" IsHitTestVisible="False"/>
        </Canvas>

        <!-- Crosshair (always centered on the game) -->
        <Grid x:Name="CrosshairLayer" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
            <Path x:Name="CrosshairShadow" Stroke="#B0000000" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path x:Name="CrosshairPath" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>

        <!-- Toasts -->
        <StackPanel x:Name="Toasts" HorizontalAlignment="Center" VerticalAlignment="Top" Width="400" IsHitTestVisible="False"/>

        <!-- Customize UI (built in code) -->
        <Border x:Name="TopBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,52" Visibility="Collapsed"/>
        <Border x:Name="MenuHost" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="12,12,12,110" Width="360" Visibility="Collapsed"/>
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed"
                Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Line.Strong}" BorderThickness="1" CornerRadius="6" Padding="12,6">
            <TextBlock x:Name="StatusText" FontFamily="{DynamicResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.Dim}"/>
        </Border>

        <!-- Screen-region picker for DEFCON OCR -->
        <Canvas x:Name="RegionLayer" Visibility="Collapsed" Background="#55000000">
            <Rectangle x:Name="RegionRect" Stroke="{DynamicResource B.Amber}" StrokeThickness="2" StrokeDashArray="4 3" Fill="#22FFC400" Visibility="Collapsed"/>
            <Border x:Name="RegionHint" Canvas.Left="40" Canvas.Top="40" Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Amber}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <TextBlock FontSize="13" Foreground="{DynamicResource B.Text}" Text="Drag a box around where your server shows its DEFCON / alert level.   Esc cancels."/>
            </Border>
        </Canvas>
    </Grid>
</Window>
