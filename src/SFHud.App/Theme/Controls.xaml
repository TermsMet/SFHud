<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SFHud.Controls">

    <!-- ================= HudFrame ================= -->
    <Style TargetType="{x:Type c:HudFrame}">
        <Setter Property="Stroke" Value="{DynamicResource B.Line.Strong}"/>
        <Setter Property="BracketBrush" Value="{DynamicResource B.Accent}"/>
        <Setter Property="TabBrush" Value="{DynamicResource B.Amber}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Corners" Value="{DynamicResource Theme.Corners}"/>
        <Setter Property="Radius" Value="{DynamicResource Theme.Radius}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:HudFrame}">
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel used for page sections. -->
    <Style x:Key="Sf.Panel" TargetType="{x:Type c:HudFrame}" BasedOn="{StaticResource {x:Type c:HudFrame}}">
        <Setter Property="Fill" Value="{DynamicResource B.Panel}"/>
        <Setter Property="Stroke" Value="{DynamicResource B.Line}"/>
        <Setter Property="Chamfer" Value="14"/>
        <Setter Property="Padding" Value="20,16,20,18"/>
        <Setter Property="BracketLength" Value="18"/>
    </Style>

    <!-- ================= Text ================= -->
    <Style x:Key="T.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
    </Style>
    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="T.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ================= Buttons ================= -->
    <!-- One template; styles swap Background/Foreground. Hover adds the glow + bright stroke. -->
    <ControlTemplate x:Key="Sf.ButtonTemplate" TargetType="Button">
        <c:HudFrame x:Name="Frame" Chamfer="9" ShowBrackets="False"
                    Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                    Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </c:HudFrame>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                <Setter TargetName="Frame" Property="Glow" Value="True"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                <Setter TargetName="Frame" Property="Glow" Value="True"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter TargetName="Frame" Property="RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.96"/></Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Sf.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource B.Accent.Fill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line.Strong}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="20,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Sf.ButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Accent.Fill2}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Accent.Fill3}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Sf.Button.Primary" TargetType="Button" BasedOn="{StaticResource Sf.Button}">
        <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource B.Accent.Solid}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Accent.Solid}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Sf.Button.Danger" TargetType="Button" BasedOn="{StaticResource Sf.Button}">
        <Setter Property="Foreground" Value="{DynamicResource B.Alert}"/>
        <Setter Property="Background" Value="#14FF2D6F"/>
        <Setter Property="BorderBrush" Value="#99FF2D6F"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Alert.Fill}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Sf.Button.Small" TargetType="Button" BasedOn="{StaticResource Sf.Button}">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="Sf.Button.Small.Danger" TargetType="Button" BasedOn="{StaticResource Sf.Button.Danger}">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="Sf.Button.Small.Primary" TargetType="Button" BasedOn="{StaticResource Sf.Button.Primary}">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- Title-bar buttons -->
    <Style x:Key="Sf.Button.Caption" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Accent.Fill2}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Sf.Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Sf.Button.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Alert.Fill}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Alert}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Navigation ================= -->
    <Style x:Key="Sf.Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Height="42" Background="Transparent">
                        <Rectangle x:Name="Wash" Opacity="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2E00E5FF" Offset="0"/>
                                    <GradientStop Color="#0000E5FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource B.Accent}" Opacity="0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                            <TextBlock x:Name="Code" Text="{TemplateBinding Tag}" Width="30"
                                       FontFamily="{DynamicResource F.Mono}" FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource B.Muted}" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Compact sidebar: no number, just the emoji -->
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Code" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="1"/>
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Lists rendered as tiles / chips ================= -->
    <Style x:Key="Sf.TileList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sf.ProfileItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <c:HudFrame x:Name="F" Chamfer="11" Padding="16,13,16,14" ShowBrackets="False"
                                Stroke="{DynamicResource B.Line}" Fill="{DynamicResource B.Accent.Fill}"
                                BracketBrush="{DynamicResource B.Amber}">
                        <ContentPresenter/>
                    </c:HudFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="F" Property="Stroke" Value="{DynamicResource B.Line.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="F" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="F" Property="Fill" Value="{DynamicResource B.Accent.Fill2}"/>
                            <Setter TargetName="F" Property="Glow" Value="True"/>
                            <Setter TargetName="F" Property="ShowBrackets" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sf.ChipItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <c:HudFrame x:Name="F" Chamfer="6" Padding="12,6" ShowBrackets="False"
                                Stroke="{DynamicResource B.Line}" Fill="Transparent">
                        <ContentPresenter/>
                    </c:HudFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="F" Property="Stroke" Value="{DynamicResource B.Line.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="F" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="F" Property="Fill" Value="{DynamicResource B.Accent.Fill2}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Inputs ================= -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <c:HudFrame x:Name="Box" Width="16" Height="16" Chamfer="4" ShowBrackets="False"
                                    Stroke="{DynamicResource B.Line.Strong}" VerticalAlignment="Center">
                            <Rectangle x:Name="Mark" Margin="3" Fill="{DynamicResource B.Accent}" Visibility="Collapsed"/>
                        </c:HudFrame>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Box" Property="Glow" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <c:HudFrame x:Name="F" Chamfer="7" Padding="10,8" ShowBrackets="False"
                                Stroke="{DynamicResource B.Line}" Fill="#0D00E5FF">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </c:HudFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="F" Property="Stroke" Value="{DynamicResource B.Line.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="F" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="F" Property="Glow" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: thin rail, filled to the thumb, diamond thumb. -->
    <Style x:Key="Sf.SliderRail" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="2" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Border Height="2" VerticalAlignment="Center" Background="{DynamicResource B.Line}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Sf.SliderRail}"
                                              Background="{DynamicResource B.Accent}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Sf.SliderRail}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Path x:Name="D" Data="M7,0 L14,7 L7,14 L0,7 Z" Fill="{DynamicResource B.Bg}"
                                                  Stroke="{DynamicResource B.Accent}" StrokeThickness="1.5"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="D" Property="Fill" Value="{DynamicResource B.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="D" Property="Fill" Value="{DynamicResource B.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scrollbars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle x:Name="R" Width="3" Fill="{DynamicResource B.Line.Strong}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="R" Property="Fill" Value="{DynamicResource B.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Sf.Page" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- ================= Icons ================= -->
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Flat icon button (toolbars, list rows). Content is a glyph or short text. -->
    <Style x:Key="Sf.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <c:HudFrame x:Name="Bd" Fill="{TemplateBinding Background}" Stroke="{x:Null}" Chamfer="5" ShowBrackets="False" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </c:HudFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Fill" Value="{DynamicResource B.Accent.Fill2}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Fill" Value="{DynamicResource B.Accent.Fill3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch look for a CheckBox. -->
    <Style x:Key="Sf.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <Grid DockPanel.Dock="Right" Width="38" Height="20" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource B.Accent.Fill}" BorderBrush="{DynamicResource B.Line.Strong}" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource B.Dim}"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.Accent.Solid}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource B.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sub-tabs (RadioButtons styled as underlined tabs). -->
    <Style x:Key="Sf.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg" CornerRadius="5,5,0,0" Background="Transparent"/>
                        <ContentPresenter Margin="12,7,12,8" VerticalAlignment="Center"/>
                        <Rectangle x:Name="Bar" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource B.Accent}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource B.Accent.Fill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill toggle (filters, chips) -->
    <Style x:Key="Sf.Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Dim}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <c:HudFrame x:Name="Bd" Chamfer="6" ShowBrackets="False" Padding="11,5" Stroke="{DynamicResource B.Line}" Fill="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </c:HudFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Stroke" Value="{DynamicResource B.Line.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Fill" Value="{DynamicResource B.Accent.Fill2}"/>
                            <Setter TargetName="Bd" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsible settings section -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <c:HudFrame Fill="{DynamicResource B.Panel}" Stroke="{DynamicResource B.Line}" Chamfer="10" ShowBrackets="False" Padding="0">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" FocusVisualStyle="{x:Null}" OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="16,11">
                                            <DockPanel>
                                                <TextBlock x:Name="Chev" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="11"
                                                           Foreground="{DynamicResource B.Dim}" VerticalAlignment="Center"/>
                                                <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chev" Property="Text" Value="&#xE70E;"/>
                                                <Setter TargetName="Chev" Property="Foreground" Value="{DynamicResource B.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="16,0,16,14" Visibility="Collapsed"/>
                        </DockPanel>
                    </c:HudFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.BgElevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line.Strong}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <c:HudFrame Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" Chamfer="7" ShowBrackets="False" Padding="11,8">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </c:HudFrame>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <c:HudFrame Fill="{DynamicResource B.BgElevated}" Stroke="{DynamicResource B.Line.Strong}" Chamfer="9" ShowBrackets="False" ShowTab="True" Padding="4,6,4,4">
                        <StackPanel IsItemsHost="True"/>
                    </c:HudFrame>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,6" MinWidth="170">
                        <Grid>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True">
                                <c:HudFrame Fill="{DynamicResource B.BgElevated}" Stroke="{DynamicResource B.Line.Strong}" Chamfer="9" ShowBrackets="False" Padding="4">
                                    <StackPanel IsItemsHost="True"/>
                                </c:HudFrame>
                            </Popup>
                            <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{StaticResource F.Icons}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource B.Dim}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent.Fill2}"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{DynamicResource B.Line}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="Sf.ComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <c:HudFrame x:Name="Bd" Fill="{DynamicResource B.Accent.Fill}" Stroke="{DynamicResource B.Line}" Chamfer="7" ShowBrackets="False">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource B.Dim}"/>
                    </c:HudFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Stroke" Value="{DynamicResource B.Line.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Stroke" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Sf.ComboToggle}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"/>
                        <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <c:HudFrame Fill="{DynamicResource B.BgElevated}" Stroke="{DynamicResource B.Line.Strong}" Chamfer="8" ShowBrackets="False"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340" Padding="4" Margin="0,2,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                            </c:HudFrame>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="9,6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent.Fill2}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource B.Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain selectable list rows -->
    <Style x:Key="Sf.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,6" Margin="0,0,0,2" BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent.Fill}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent.Fill2}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Line.Strong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
