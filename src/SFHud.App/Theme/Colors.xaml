<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:SFHud.Services"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        SFHud palette. Base values follow the MIT-licensed sci-fi kits we draw from:
        cyan accent #00E5FF, signal pink #FF2D6F, deep background #05080C (boy-offi9-inc/scifi-ui-kit),
        alpha steps for borders/glow (jonnysmillie/astro-sci-fi-ui). Amber is SFHud's urgency accent.
    -->
    <Color x:Key="C.Bg">#FF05080C</Color>
    <Color x:Key="C.BgElevated">#FF09111A</Color>
    <Color x:Key="C.Accent">#FF00E5FF</Color>
    <Color x:Key="C.Amber">#FFFFC400</Color>
    <Color x:Key="C.Alert">#FFFF2D6F</Color>
    <Color x:Key="C.Ok">#FF7CFFB2</Color>
    <Color x:Key="C.Text">#FFE8FDFF</Color>
    <Color x:Key="C.Dim">#FF7FB8C4</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="B.BgElevated" Color="{StaticResource C.BgElevated}"/>
    <SolidColorBrush x:Key="B.Panel" Color="#C009111A"/>
    <SolidColorBrush x:Key="B.Card" Color="#E605080C"/>

    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.Accent.Fill" Color="#1400E5FF"/>   <!-- 8%  -->
    <SolidColorBrush x:Key="B.Accent.Fill2" Color="#2600E5FF"/>  <!-- 15% -->
    <SolidColorBrush x:Key="B.Accent.Fill3" Color="#4000E5FF"/>  <!-- 25% -->
    <SolidColorBrush x:Key="B.Accent.Solid" Color="#D900E5FF"/>  <!-- 85% -->
    <SolidColorBrush x:Key="B.Line" Color="#3D00E5FF"/>          <!-- 24% -->
    <SolidColorBrush x:Key="B.Line.Strong" Color="#9400E5FF"/>   <!-- 58% -->

    <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}"/>
    <SolidColorBrush x:Key="B.Amber.Fill" Color="#1FFFC400"/>
    <SolidColorBrush x:Key="B.Alert" Color="{StaticResource C.Alert}"/>
    <SolidColorBrush x:Key="B.Alert.Fill" Color="#33FF2D6F"/>
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}"/>

    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.Dim" Color="{StaticResource C.Dim}"/>
    <SolidColorBrush x:Key="B.Muted" Color="#997FB8C4"/>

    <LinearGradientBrush x:Key="B.Divider" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0000E5FF" Offset="0"/>
        <GradientStop Color="#9400E5FF" Offset="0.18"/>
        <GradientStop Color="#3D00E5FF" Offset="0.7"/>
        <GradientStop Color="#0000E5FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Divider.Vertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0000E5FF" Offset="0"/>
        <GradientStop Color="#5200E5FF" Offset="0.3"/>
        <GradientStop Color="#2000E5FF" Offset="0.85"/>
        <GradientStop Color="#0000E5FF" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="B.Wash.Accent" Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="#2600E5FF" Offset="0"/>
        <GradientStop Color="#0000E5FF" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="B.Wash.Amber" Center="0.92,1" GradientOrigin="0.92,1" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#14FFC400" Offset="0"/>
        <GradientStop Color="#00FFC400" Offset="1"/>
    </RadialGradientBrush>

    <!-- 1px line every 3px; used at ~5% opacity. -->
    <DrawingBrush x:Key="B.Scanlines" TileMode="Tile" Stretch="None"
                  Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF00E5FF">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,2,4,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Faint 48px tactical grid. -->
    <DrawingBrush x:Key="B.Grid" TileMode="Tile" Stretch="None"
                  Viewport="0,0,48,48" ViewportUnits="Absolute" Viewbox="0,0,48,48" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,48,48"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF00E5FF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,48,1"/>
                            <RectangleGeometry Rect="0,0,1,48"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!--
        Fonts: Orbitron and Share Tech Mono (both SIL OFL) are used by astro-sci-fi-ui.
        If they are not installed, WPF falls back to Windows' built-in Bahnschrift / Cascadia Mono / Consolas.
    -->
    <FontFamily x:Key="F.Display">Orbitron, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Share Tech Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="F.Body">Bahnschrift, Segoe UI</FontFamily>

    <!-- Replaced at startup by ThemeManager. -->
    <s:HudCorners x:Key="Theme.Corners">Chamfer</s:HudCorners>
    <sys:Double x:Key="Theme.Radius">8</sys:Double>
    <SolidColorBrush x:Key="B.OnAccent" Color="#FF05080C"/>
    <Visibility x:Key="V.Scanlines">Visible</Visibility>

</ResourceDictionary>
